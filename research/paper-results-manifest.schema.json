{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archsync.dev/schemas/paper-results-manifest-0.1.0.json",
  "title": "ArchSync paper results manifest",
  "description": "Provenance contract for EVAL-111 and ANALYSIS-101. A template-not-evidence document contains no empirical value.",
  "oneOf": [
    {
      "$ref": "#/$defs/template"
    },
    {
      "$ref": "#/$defs/generated"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema_version",
        "status",
        "task_ids",
        "generated_at",
        "dataset",
        "analysis_plan",
        "pipeline",
        "tables",
        "figures",
        "report",
        "limitations",
        "deviations"
      ],
      "properties": {
        "$schema": {
          "const": "./paper-results-manifest.schema.json"
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "status": {
          "enum": ["template-not-evidence", "generated-evidence"]
        },
        "task_ids": {
          "const": ["EVAL-111", "ANALYSIS-101"]
        },
        "generated_at": true,
        "dataset": true,
        "analysis_plan": true,
        "pipeline": true,
        "tables": true,
        "figures": true,
        "report": true,
        "limitations": true,
        "deviations": true
      }
    },
    "template": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "status": {
              "const": "template-not-evidence"
            },
            "generated_at": {
              "type": "null"
            },
            "dataset": {
              "type": "null"
            },
            "analysis_plan": {
              "type": "null"
            },
            "pipeline": {
              "type": "array",
              "maxItems": 0
            },
            "tables": {
              "type": "array",
              "maxItems": 0
            },
            "figures": {
              "type": "array",
              "maxItems": 0
            },
            "report": {
              "type": "null"
            },
            "limitations": {
              "type": "array",
              "maxItems": 0
            },
            "deviations": {
              "type": "null"
            }
          }
        }
      ]
    },
    "generated": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "status": {
              "const": "generated-evidence"
            },
            "generated_at": {
              "type": "string",
              "format": "date-time"
            },
            "dataset": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version", "frozen_at", "sha256", "repository_count"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1},
                "frozen_at": {"type": "string", "format": "date-time"},
                "sha256": {"$ref": "#/$defs/sha256"},
                "repository_count": {"type": "integer", "minimum": 1}
              }
            },
            "analysis_plan": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "frozen_at", "sha256"],
              "properties": {
                "version": {"type": "string", "minLength": 1},
                "frozen_at": {"type": "string", "format": "date-time"},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            },
            "pipeline": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stage", "command", "input_sha256", "output_sha256", "environment_sha256"],
                "properties": {
                  "stage": {"enum": ["raw", "validated", "normalized", "tables", "figures"]},
                  "command": {"type": "string", "minLength": 1},
                  "input_sha256": {"$ref": "#/$defs/sha256"},
                  "output_sha256": {"$ref": "#/$defs/sha256"},
                  "environment_sha256": {"$ref": "#/$defs/sha256"}
                }
              }
            },
            "tables": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "path", "sha256", "n", "uncertainty_method"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "path": {"type": "string", "minLength": 1},
                  "sha256": {"$ref": "#/$defs/sha256"},
                  "n": {"type": "integer", "minimum": 0},
                  "uncertainty_method": {"type": "string", "minLength": 1}
                }
              }
            },
            "figures": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "path", "sha256", "source_table_ids"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "path": {"type": "string", "minLength": 1},
                  "sha256": {"$ref": "#/$defs/sha256"},
                  "source_table_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1},
                    "uniqueItems": true
                  }
                }
              }
            },
            "report": {
              "$ref": "#/$defs/artifact"
            },
            "limitations": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "deviations": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "#/$defs/artifact"}
              ]
            }
          }
        }
      ]
    }
  }
}
